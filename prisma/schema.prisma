// Platera Jewellers — data model.
// Money: integer paise. Weight: integer milligrams. Never floats.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────

enum MetalKey {
  SILVER_925
  GOLD_22K
  GOLD_18K
  GOLD_14K
  PLATINUM_950
}

enum PricingMode {
  LIVE
  FIXED
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Availability {
  IN_STOCK
  MADE_TO_ORDER
}

enum StoneType {
  NONE
  CUBIC_ZIRCONIA
  NATURAL_DIAMOND
  LAB_GROWN_DIAMOND
  KUNDAN_GLASS
  PEARL
  GEMSTONE
  MIXED
}

enum ImageKind {
  PHOTO
  TURNTABLE
  MODEL
  SCALE
  VIDEO
  CERTIFICATE
}

enum AdminRole {
  OWNER
  STAFF
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  PAID_OUT_OF_STOCK
}

enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum AppointmentKind {
  STORE_VISIT
  VIDEO_CALL
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum EnquiryKind {
  PIECE
  CUSTOM_ORDER
  GENERAL
}

enum EnquiryStatus {
  NEW
  REPLIED
  CLOSED
}

enum ServiceKind {
  REPAIR
  RESIZE
  POLISH
  ALTERATION
  OTHER
}

enum ServiceStatus {
  RECEIVED
  QUOTED
  IN_PROGRESS
  READY
  RETURNED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

// ─── Rates ──────────────────────────────────────────────────────────────

/// One row per rate change. The live rate for a metal is the newest row whose
/// effectiveAt has passed. Rows are never edited, so every past order can be
/// traced to the exact rate it was priced at.
model MetalRate {
  id           String     @id @default(cuid())
  metal        MetalKey
  paisePerGram Int
  effectiveAt  DateTime   @default(now())
  createdAt    DateTime   @default(now())
  setById      String?
  setBy        AdminUser? @relation(fields: [setById], references: [id])
  note         String?

  @@index([metal, effectiveAt(sort: Desc)])
}

// ─── Catalogue ──────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  /// Short line under the heading.
  summary     String
  /// 150–250 words of buying guidance, shown on the category page.
  guide       String
  seoTitle    String
  seoDescription String
  position    Int       @default(0)
  products    Product[]
}

model Collection {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String
  published   Boolean   @default(false)
  startsAt    DateTime?
  endsAt      DateTime?
  products    Product[]
}

model Product {
  id              String         @id @default(cuid())
  sku             String         @unique
  slug            String         @unique
  name            String
  /// One or two sentences: what it is and why it was chosen.
  summary         String
  description     String
  status          ProductStatus  @default(DRAFT)
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])
  collections     Collection[]

  // Metal and pricing
  metal           MetalKey       @default(SILVER_925)
  pricingMode     PricingMode    @default(LIVE)
  /// e.g. "Gold plated" for gold-tone pieces in silver. Null for plain metal.
  finish          String?
  netWeightMg     Int?
  grossWeightMg   Int?
  /// The client offers no weight tolerance, so a live-rate piece is only sold once
  /// the owner has weighed it and confirmed the figure in admin.
  weightVerified  Boolean        @default(false)
  makingPct       Int?
  stonePaise      Int            @default(0)
  hallmarkPaise   Int            @default(0)
  fixedPricePaise Int?

  // Disclosure
  hallmarked      Boolean        @default(true)
  huid            String?
  stoneType       StoneType      @default(NONE)
  stoneDetails    String?

  // Stock and fulfilment
  stock           Int            @default(1)
  availability    Availability   @default(IN_STOCK)
  leadTimeDays    String?
  returnable      Boolean        @default(true)
  returnNote      String?
  soldAt          DateTime?

  // Size
  lengthInches    Decimal?       @db.Decimal(4, 1)
  sizeNote        String?
  dimensions      String?

  // Merchandising and SEO
  featured        Boolean        @default(false)
  position        Int            @default(0)
  seoTitle        String?
  seoDescription  String?

  images          ProductImage[]
  certificates    Certificate[]
  orderItems      OrderItem[]
  cartItems       CartItem[]
  enquiries       Enquiry[]
  notifications   StockNotification[]
  reviews         Review[]
  wishlistItems   WishlistItem[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  publishedAt     DateTime?

  @@index([status, categoryId, position])
}

model ProductImage {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  kind      ImageKind @default(PHOTO)
  index     Int
  /// Base path under /media without size or extension, e.g. "products/PLT-NKS-001-01".
  src       String
  width     Int
  height    Int
  alt       String
  /// 20px blur placeholder as a data URI.
  lqip      String

  @@unique([productId, kind, index])
}

model Certificate {
  id        String   @id @default(cuid())
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  issuer    String
  number    String?
  fileUrl   String
  mimeType  String
  createdAt DateTime @default(now())
}

// ─── Customers ──────────────────────────────────────────────────────────

model Customer {
  id        String     @id @default(cuid())
  email     String?    @unique
  phone     String?    @unique
  name      String?
  addresses Address[]
  orders    Order[]
  wishlist  WishlistItem[]
  services  ServiceRequest[]
  createdAt DateTime   @default(now())
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  isDefault  Boolean  @default(false)
}

model WishlistItem {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, productId])
}

// ─── Cart and orders ────────────────────────────────────────────────────

model Cart {
  id        String     @id @default(cuid())
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id             String   @id @default(cuid())
  cartId         String
  cart           Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty            Int      @default(1)
  /// The total the customer last saw for this line. Checkout re-prices against it.
  seenTotalPaise Int
  addedAt        DateTime @default(now())

  @@unique([cartId, productId])
}

model Order {
  id                String        @id @default(cuid())
  number            String        @unique
  customerId        String?
  customer          Customer?     @relation(fields: [customerId], references: [id])
  name              String
  email             String
  phone             String
  /// Snapshot of the delivery address at the time of order.
  shippingAddress   Json
  status            OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus     PaymentStatus @default(PENDING)
  subtotalPaise     Int
  gstPaise          Int
  shippingPaise     Int           @default(0)
  totalPaise        Int
  /// Rates used to price this order, keyed by metal.
  rates             Json
  policyAcceptedAt  DateTime
  giftMessage       String?
  hidePrices        Boolean       @default(false)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  paidAt            DateTime?
  // Shipping
  courier           String?
  awb               String?
  shiprocketOrderId String?
  shipmentId        String?
  trackingEvents    Json?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  adminNotes        String?
  items             OrderItem[]
  refunds           Refund[]
  services          ServiceRequest[]
  reviews           Review[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status, createdAt(sort: Desc)])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  sku            String
  name           String
  qty            Int
  unitTotalPaise Int
  /// The pricing input and full Ledger breakdown, frozen at purchase.
  pricingInput   Json
  breakdown      Json
}

model Refund {
  id               String   @id @default(cuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id])
  amountPaise      Int
  reason           String
  breakdown        Json
  razorpayRefundId String?  @unique
  status           String   @default("PENDING")
  createdById      String?
  createdAt        DateTime @default(now())
}

/// Every provider event id we have processed, so a retried webhook is a no-op.
model WebhookEvent {
  id          String   @id
  provider    String
  type        String
  receivedAt  DateTime @default(now())
}

// ─── Conversations ──────────────────────────────────────────────────────

model Enquiry {
  id        String        @id @default(cuid())
  kind      EnquiryKind   @default(PIECE)
  productId String?
  product   Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  phone     String
  email     String?
  message   String
  status    EnquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
}

model Appointment {
  id         String            @id @default(cuid())
  kind       AppointmentKind
  /// Calendar date in Asia/Kolkata, stored as midnight UTC of that date.
  date       DateTime          @db.Date
  /// "10:00", "16:30" — store-local start time.
  slot       String
  name       String
  phone      String
  email      String?
  notes      String?
  productIds String[]
  status     AppointmentStatus @default(REQUESTED)
  adminNotes String?
  createdAt  DateTime          @default(now())

  @@index([date, slot])
}

model ServiceRequest {
  id          String        @id @default(cuid())
  customerId  String?
  customer    Customer?     @relation(fields: [customerId], references: [id])
  orderId     String?
  order       Order?        @relation(fields: [orderId], references: [id])
  kind        ServiceKind
  description String
  name        String
  phone       String
  status      ServiceStatus @default(RECEIVED)
  quotePaise  Int?
  adminNotes  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Review {
  id        String       @id @default(cuid())
  productId String?
  product   Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  orderId   String?
  order     Order?       @relation(fields: [orderId], references: [id])
  name      String
  city      String?
  rating    Int
  body      String
  photos    String[]
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())
}

model StockNotification {
  id         String    @id @default(cuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  contact    String
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?
}

// ─── Admin ──────────────────────────────────────────────────────────────

model AdminUser {
  id        String      @id @default(cuid())
  email     String      @unique
  name      String
  role      AdminRole   @default(STAFF)
  active    Boolean     @default(true)
  rates     MetalRate[]
  createdAt DateTime    @default(now())
}

/// One-time sign-in codes. Only a hash is stored.
model OtpCode {
  id         String    @id @default(cuid())
  identifier String
  audience   String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier, audience, createdAt(sort: Desc)])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  audience   String
  subjectId  String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

/// Owner-editable settings: the homepage hero slot, shipping charge, buyback text.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}
