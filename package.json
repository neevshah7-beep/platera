{
  "name": "platera",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.mts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
