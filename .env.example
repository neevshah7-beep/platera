# Copy to .env.local for your computer, or enter these in your host's settings for the live site.
# Never commit real values.

# The live address, with https and no trailing slash. Every canonical link, sitemap entry,
# share card and WhatsApp message is built from it.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Set to 1 on the live site only. Without it robots.txt and every page tell search engines to stay out.
SITE_INDEXABLE=

# Postgres connection string.
DATABASE_URL=

# Any long random string; signs order links.
ORDER_TOKEN_SECRET=

# Optional: the codes Google Search Console and Bing Webmaster Tools give you to prove ownership.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Optional: analytics.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Optional: photographs uploaded from the admin (Vercel Blob).
BLOB_READ_WRITE_TOKEN=
